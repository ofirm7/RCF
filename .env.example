# PostgreSQL (used when running outside Docker)
DATABASE_URL=postgresql://rcf:rcf@localhost:5432/rcf

# Anthropic (Claude API for NLP classification)
ANTHROPIC_API_KEY=sk-ant-...

# GovMap API (address resolution)
# GOVMAP_API_URL=https://es.govmap.gov.il/TldSearch/api/DetailsByQuery

# MAVAT (national planning database)
# MAVAT_BASE_URL=https://mavat.iplan.gov.il

# Scanner settings
SCANNER_CONCURRENCY=5
SCANNER_RETRY_ATTEMPTS=3
CLASSIFIER_CONFIDENCE_THRESHOLD=0.7

# Address ingestion (CBS data.gov.il)
RUN_INGESTION=false
INGEST_CITY=תל אביב
INGEST_MAX_HOUSE=100
